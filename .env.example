# ==========================================================
# SERVIÇO WEB (app.py) — usado local e no Render
# ==========================================================

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Local: true habilita a opção Ollama na interface.
# Render: defina como false — Ollama não faz parte da
# infraestrutura hospedada (exige um servidor Ollama rodando
# na mesma máquina, o que não existe em produção).
ENABLE_OLLAMA=true

# Pasta onde ficam o banco SQLite (portfolio.db) e os arquivos
# temporários de processamento. No Render, deve apontar para o
# Persistent Disk (ex.: /data) — sem isso, os dados são
# apagados a cada deploy/restart.
CETRUS_DATA_DIR=./data

# Usado somente quando ENABLE_OLLAMA=true (ambiente local).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=900


# ==========================================================
# CLI LEGADA (main.py --run / --status / --retry-errors)
# ==========================================================
#
# As variáveis abaixo são lidas somente por
# src/portfolio/config.py, usado pela CLI standalone — não têm
# nenhum efeito no serviço web (app.py) nem no Render.

AI_PROVIDER=Gemini
AI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

VIDEO_DIR=./videos
MAX_CONCURRENCY=10

JW_SITE_ID=XdfUPSCL
JW_DELIVERY_TOKEN=

FRAME_COUNT=8
TRANSCRIBE=false
WHISPER_MODEL=small
MAX_RETRIES=3

INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
