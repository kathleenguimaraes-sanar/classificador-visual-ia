# Copie para /srv/pirata/cetruslabia/backend.env na maquina Pirata.
# Nunca adicione o arquivo real ao Git.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

ENABLE_OLLAMA=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=900

APP_AUTH_ENABLED=true
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_SECRET=
APP_AUTH_SESSION_TTL_SECONDS=28800
APP_AUTH_LOGIN_MAX_ATTEMPTS=5
APP_AUTH_LOGIN_WINDOW_SECONDS=300

# Mantenha false ate que todo acesso passe exclusivamente pelo tunel confiavel.
APP_AUTH_TRUST_PROXY_HEADERS=false
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAMESITE=lax

# Informe a origem HTTPS exata do frontend, sem barra no final.
CORS_ALLOWED_ORIGINS=

AI_PROVIDER=Gemini
AI_MODEL=gemini-flash-latest
FRAME_COUNT=8
TRANSCRIBE=false
WHISPER_MODEL=small
MAX_RETRIES=3

JW_SITE_ID=XdfUPSCL
JW_DELIVERY_TOKEN=

INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
